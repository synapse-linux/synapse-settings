{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/schemas/settings/graphics-policy-view-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["generation", "defaultGpu", "rules", "schema", "present", "enforcementAvailable", "enforcementReason", "runningProcessMigration"],
  "properties": {
    "schema": {"const": "synapse.settings.graphics-policy-view/v1"},
    "generation": {"type": "integer", "minimum": 0},
    "defaultGpu": {"type": "string", "pattern": "^(system|gpu-[0-9a-f]{16})$"},
    "rules": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "match", "gpu", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^rule-[0-9]{4,}$"},
          "match": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "displayPath"],
            "properties": {
              "type": {"enum": ["executable", "directory"]},
              "displayPath": {"type": "string", "maxLength": 4096}
            }
          },
          "gpu": {"type": "string", "pattern": "^(system|gpu-[0-9a-f]{16})$"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "present": {"type": "boolean"},
    "enforcementAvailable": {"const": false},
    "enforcementReason": {"const": "launch-broker-not-integrated"},
    "runningProcessMigration": {"const": false}
  }
}

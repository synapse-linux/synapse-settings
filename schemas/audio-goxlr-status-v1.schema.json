{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.invalid/schema/settings/audio-goxlr-status-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "reason",
    "providerActive",
    "deviceCount",
    "truncated",
    "devices",
    "stateAuthority",
    "hardwareReadback",
    "hardwareExactRollback",
    "mutationAvailable",
    "readOnly",
    "bounded"
  ],
  "properties": {
    "schema": {
      "const": "synapse.settings.audio-goxlr-status/v1"
    },
    "status": {
      "enum": [
        "Ready",
        "Inactive",
        "Unavailable",
        "Failed"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "adapter-unavailable",
        "provider-inactive",
        "timeout",
        "response-too-large",
        "invalid-response",
        "status-unavailable"
      ]
    },
    "providerActive": {
      "type": "boolean"
    },
    "deviceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "truncated": {
      "type": "boolean"
    },
    "devices": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "stateAuthority": {
      "const": "provider-profile-model"
    },
    "hardwareReadback": {
      "const": false
    },
    "hardwareExactRollback": {
      "const": false
    },
    "mutationAvailable": {
      "const": false
    },
    "readOnly": {
      "const": true
    },
    "bounded": {
      "const": true
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model",
        "systemOutputSupported",
        "controlAvailable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^goxlr-[1-8]$"
        },
        "model": {
          "enum": [
            "GoXLR Mini",
            "GoXLR",
            "Unknown"
          ]
        },
        "systemOutputSupported": {
          "type": "boolean"
        },
        "controlAvailable": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "Ready"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": null
          },
          "providerActive": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "providerActive": {
            "const": false
          },
          "deviceCount": {
            "const": 0
          },
          "truncated": {
            "const": false
          },
          "devices": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "adapter-unavailable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Inactive"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "provider-inactive"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Failed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "timeout",
              "response-too-large",
              "invalid-response",
              "status-unavailable"
            ]
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "deviceCount": {
              "const": 0
            },
            "devices": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 1
            },
            "devices": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 2
            },
            "devices": {
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 3
            },
            "devices": {
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 4
            },
            "devices": {
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 5
            },
            "devices": {
              "minItems": 5,
              "maxItems": 5
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 6
            },
            "devices": {
              "minItems": 6,
              "maxItems": 6
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 7
            },
            "devices": {
              "minItems": 7,
              "maxItems": 7
            }
          }
        },
        {
          "properties": {
            "deviceCount": {
              "const": 8
            },
            "devices": {
              "minItems": 8,
              "maxItems": 8
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "deviceCount": {
            "const": 8
          }
        }
      }
    }
  ]
}

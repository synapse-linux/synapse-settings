{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/schemas/settings/sections-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sections"],
  "properties": {
    "schema": {"const": "synapse.settings.sections/v2"},
    "sections": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "icon", "available", "lazy"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 64},
          "icon": {"type": "string", "minLength": 1, "maxLength": 64},
          "available": {"type": "boolean"},
          "lazy": {"type": "boolean"}
        }
      }
    }
  }
}

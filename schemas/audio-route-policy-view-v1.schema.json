{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.invalid/schemas/settings/audio-route-policy-view-v1.schema.json",
  "title": "Synapse Settings audio route policy view v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generation", "rules", "present", "systemDefaultFallback", "enforcementAvailable", "enforcementReason", "persistentPidRules", "existingStreamMigration"],
  "properties": {
    "schema": {"const": "synapse.settings.audio-route-policy-view/v1"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "rules": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "direction", "device", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^rule-[0-9]{4}$"},
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "displayPath"],
            "properties": {
              "type": {"enum": ["executable", "directory"]},
              "displayPath": {"type": "string", "minLength": 1, "maxLength": 4095}
            }
          },
          "direction": {"enum": ["output", "input"]},
          "device": {"type": "string", "pattern": "^(output|input)-[0-9a-f]{16}$"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "present": {"type": "boolean"},
    "systemDefaultFallback": {"const": true},
    "enforcementAvailable": {"const": false},
    "enforcementReason": {"const": "audio-route-broker-not-integrated"},
    "persistentPidRules": {"const": false},
    "existingStreamMigration": {"const": false}
  }
}
